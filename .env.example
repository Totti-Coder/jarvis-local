# Copia este fichero como .env y rellena tus valores.
# Se consiguen en console.cloud.google.com:
#   APIs y servicios -> Credenciales -> ID de cliente OAuth
#   -> tipo 'Aplicacion de escritorio'
#
# Sin estas variables Jarvis funciona igual: simplemente no sincroniza
# con Google Calendar.

GOOGLE_CLIENT_ID=tu-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto
GOOGLE_PROJECT_ID=el-nombre-de-tu-proyecto
